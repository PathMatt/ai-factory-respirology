{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://camp-pods.vercel.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|json|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(mp4|jpg|jpeg|png|svg|dzi|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
